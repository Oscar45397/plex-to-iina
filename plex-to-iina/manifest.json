{
  "manifest_version": 3,
  "name": "Plex → IINA",
  "version": "1.1.0",
  "description": "Press Play in Plex Web and the original file streams in IINA: no transcoding, full-bitrate 4K remuxes, lossless multichannel audio.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage", "downloads"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Plex → IINA",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.plex.tv/*",
        "*://*/web/index.html*"
      ],
      "js": ["languages.js", "content.js", "download.js"],
      "run_at": "document_start"
    }
  ]
}
