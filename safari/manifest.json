{
  "manifest_version": 3,
  "name": "Plex → IINA",
  "version": "2.0.0",
  "description": "Plex Web's Play opens the original file in IINA: no transcoding, synced progress, next episode, Skip Intro and offline downloads.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage", "nativeMessaging"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Plex → IINA",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.plex.tv/*",
        "*://*/web/index.html*"
      ],
      "js": ["languages.js", "content.js", "download.js"],
      "run_at": "document_start"
    }
  ]
}
